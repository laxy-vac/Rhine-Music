{
  "name": "rhine-music",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/export-records.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "build:source": "node scripts/build-source-preview.mjs --interface-only",
    "build:native": "node scripts/build-native-audio.mjs",
    "build:sony": "node scripts/build-sony-x86.mjs",
    "desktop": "node scripts/launch-source-preview.mjs",
    "music": "node scripts/music-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "package:windows": "node scripts/package-windows.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "basic-ftp": "6.2.2",
    "music-metadata": "^11.15.0",
    "opencc-js": "^1.4.2",
    "three": "^0.183.0",
    "taglib-wasm": "2.4.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Rhine Music — Windows music player with Rhine Lab: Reflections and Lone Trail–Inspired themes"
}
