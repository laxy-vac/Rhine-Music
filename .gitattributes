# Source files are LF everywhere so a Windows checkout fingerprints, builds and
# runs exactly like the macOS original. Windows scripts must stay CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.command text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.glb binary
*.blend binary
*.woff2 binary
*.pdf binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.m4a binary
*.zip binary
*.exe binary
*.dll binary
# Pinned upstream audio sources retain their exact archive bytes for SHA-256.
vendor/audio/iir1/** -text
vendor/audio/r8brain/** -text
vendor/audio/codec-sdk/** -text
vendor/audio/soxr/** -text
vendor/audio/lsp/** -text
vendor/audio/lsp-plugin/** -text
# Original RhinE film frames/metadata retain their upstream byte hashes.
src/assets/style/intro/** -text
